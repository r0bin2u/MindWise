OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-7b-psychqa
BASE_MODEL=qwen2.5:7b

CHROMA_PATH=./data/kb
EXCEL_LOG_PATH=./data/consult_log.xlsx

# Vector store backend:
#   chroma (default): HNSW via hnswlib, embeds internally
#   faiss:            HNSW via faiss.IndexHNSWFlat (needs the [faiss] extra)
#   milvus:           standalone Milvus, IVF_FLAT index (needs the [milvus] extra
#                     + `docker compose up -d etcd minio milvus`)
# Switching backends means rebuilding the KB with that backend.
VECTOR_BACKEND=chroma
# FAISS index location (only used when VECTOR_BACKEND=faiss)
FAISS_PATH=./data/kb_faiss
# Milvus connection (only used when VECTOR_BACKEND=milvus)
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=mindwise_psych
MILVUS_INDEX_TYPE=IVF_FLAT
MILVUS_METRIC=COSINE

# Embedding backend for Chroma.
#   sentence_transformer (default): local BAAI/bge-small-zh-v1.5, zero API cost
#   openai:                        text-embedding-3-small, higher precision, needs key
# If you switch this after having built the KB, drop data/kb/ and rebuild.
EMBEDDING_BACKEND=sentence_transformer
# Leave empty to use the default model for the chosen backend
EMBEDDING_MODEL=
# Only needed when EMBEDDING_BACKEND=openai
OPENAI_API_KEY=
# Optional — set for Azure OpenAI or a proxy endpoint
OPENAI_BASE_URL=

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
ALERT_TO=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
