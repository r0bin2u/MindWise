OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-7b-psychqa
BASE_MODEL=qwen2.5:7b

CHROMA_PATH=./data/kb
EXCEL_LOG_PATH=./data/consult_log.xlsx

# Embedding backend for Chroma.
#   sentence_transformer (default): local BAAI/bge-small-zh-v1.5, zero API cost
#   openai:                        text-embedding-3-small, higher precision, needs key
# If you switch this after having built the KB, drop data/kb/ and rebuild.
EMBEDDING_BACKEND=sentence_transformer
# Leave empty to use the default model for the chosen backend
EMBEDDING_MODEL=
# Only needed when EMBEDDING_BACKEND=openai
OPENAI_API_KEY=
# Optional — set for Azure OpenAI or a proxy endpoint
OPENAI_BASE_URL=

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
ALERT_TO=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
