# Backend base URL used by the SSE client (lib/api.ts).
#
# Leave EMPTY for:
#   - local dev (the Vite proxy at vite.config.ts forwards /v1/* to
#     http://localhost:8000 automatically)
#   - public Vercel demos (the frontend auto-falls back to mock mode
#     when this is empty in a production build)
#
# Set to a backend URL to point a deployed frontend at a real
# backend, e.g.:
#   VITE_API_BASE=https://mindwise-api.fly.dev
#
# Note: VITE_*-prefixed vars are bundled into the client; do not
# put secrets here.
VITE_API_BASE=
